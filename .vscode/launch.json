{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Echoes of Eldoria",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/eldoria.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/w64devkit/bin/gdb.exe",
      "preLaunchTask": "build",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}